		<expression><![CDATA[$F{totalCost} != null ? $F{totalCost} : ($F{cost} != null ? $F{cost}.multiply(java.math.BigDecimal.valueOf($F{qty} != null ? $F{qty} : 0)) : java.math.BigDecimal.ZERO)]]></expression>
