								<expression><![CDATA["  " + ($F{paymentType} != null ? $F{paymentType} : "")]]></expression>
							</element>
						</detailCell>
					</column>
					<!-- Total Received -->
					<column kind="single" uuid="a1b2c3d4-0001-4444-8888-111122223334" width="100">
						<property name="com.jaspersoft.studio.components.table.model.column.name" value="Column2"/>
						<columnHeader height="18" rowSpan="1" style="Table_CH">
							<element kind="staticText" uuid="a1b2c3d4-0001-4444-8888-111122223335" x="0" y="0" width="100" height="18" fontName="Khmer OS Siemreap" fontSize="8.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
								<text><![CDATA[RECEIVED  ]]></text>
							</element>
						</columnHeader>
						<detailCell height="16" style="Table_TD">
							<element kind="textField" uuid="a1b2c3d4-0001-4444-8888-111122223336" x="0" y="0" width="100" height="16" fontName="Khmer OS Siemreap" fontSize="8.0" hTextAlign="Right" vTextAlign="Middle">
								<expression><![CDATA[($F{currencySymbol} != null ? $F{currencySymbol} + " " : "$ ") + ($F{totalReceived} != null ? $F{totalReceived} : "0.00") + "  "]]></expression>
							</element>
						</detailCell>
					</column>
				</component>
			</element>
		</element>

		<!-- Financial Summary Box (Right) -->
		<element kind="frame" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce0" x="275" y="34" width="280" height="142">
			<box>
				<pen lineWidth="0.5" lineColor="#CBD5E1"/>
			</box>
			<element kind="frame" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce1" x="0" y="0" width="280" height="20" backcolor="#8C0A39" mode="Opaque">
				<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce2" x="10" y="0" width="260" height="20" forecolor="#FFFFFF" fontName="Khmer OS Siemreap" fontSize="8.0" bold="true" hTextAlign="Center" vTextAlign="Middle">
					<text><![CDATA[FINANCIAL SUMMARY]]></text>
				</element>
			</element>
			<!-- Subtotal -->
			<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce3" x="8" y="22" width="125" height="13" forecolor="#475569" fontName="Khmer OS Siemreap" fontSize="7.5" vTextAlign="Middle">
				<text><![CDATA[Subtotal:]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce4" x="135" y="22" width="137" height="13" forecolor="#0F172A" fontName="Khmer OS Siemreap" fontSize="7.5" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[($P{CurrencySymbol} != null ? $P{CurrencySymbol} + " " : "$ ") + ($P{Subtotal} != null ? $P{Subtotal} : "0.00")]]></expression>
			</element>
			<!-- Discount -->
			<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce5" x="8" y="35" width="125" height="13" forecolor="#475569" fontName="Khmer OS Siemreap" fontSize="7.5" vTextAlign="Middle">
				<text><![CDATA[Discount:]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce6" x="135" y="35" width="137" height="13" forecolor="#DC2626" fontName="Khmer OS Siemreap" fontSize="7.5" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[($P{DiscountInvoice} != null && !$P{DiscountInvoice}.equals("0") && !$P{DiscountInvoice}.equals("0.00") ? "-" + $P{DiscountInvoice} : "0.00")]]></expression>
			</element>
			<!-- VAT -->
			<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce7" x="8" y="48" width="125" height="13" forecolor="#475569" fontName="Khmer OS Siemreap" fontSize="7.5" vTextAlign="Middle">
				<text><![CDATA[VAT:]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce8" x="135" y="48" width="137" height="13" forecolor="#0F172A" fontName="Khmer OS Siemreap" fontSize="7.5" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$P{Vat} != null ? $P{Vat} : "0.00"]]></expression>
			</element>
			<!-- Expense -->
			<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce9" x="8" y="61" width="125" height="13" forecolor="#475569" fontName="Khmer OS Siemreap" fontSize="7.5" vTextAlign="Middle">
				<text><![CDATA[Expense ($/KHR):]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cea" x="135" y="61" width="137" height="13" forecolor="#0F172A" fontName="Khmer OS Siemreap" fontSize="7.5" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[($P{Expense} != null && !$P{Expense}.isBlank() ? "$" + $P{Expense} : "$0.00") + " / " + ($P{ExpenseRiel} != null && !$P{ExpenseRiel}.isBlank() ? $P{ExpenseRiel} + " KHR" : "0 KHR")]]></expression>
			</element>
			<!-- Cash Change -->
			<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ceb" x="8" y="74" width="125" height="13" forecolor="#475569" fontName="Khmer OS Siemreap" fontSize="7.5" vTextAlign="Middle">
				<text><![CDATA[Change:]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cec" x="135" y="74" width="137" height="13" forecolor="#0F172A" fontName="Khmer OS Siemreap" fontSize="7.5" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$P{CashChange} != null ? "$" + $P{CashChange} : "$0.00"]]></expression>
			</element>
			<!-- Exchange Rate -->
			<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ced" x="8" y="87" width="125" height="13" forecolor="#475569" fontName="Khmer OS Siemreap" fontSize="7.5" vTextAlign="Middle">
				<text><![CDATA[Ex. Rate:]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cee" x="135" y="87" width="137" height="13" forecolor="#0F172A" fontName="Khmer OS Siemreap" fontSize="7.5" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA["1 USD = " + ($P{ExchangeRate} != null && !$P{ExchangeRate}.isBlank() ? $P{ExchangeRate} : "4,100") + " KHR"]]></expression>
			</element>
			<!-- Divider Line -->
			<element kind="line" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cef" x="8" y="101" width="264" height="1">
				<pen lineWidth="0.5" lineColor="#CBD5E1"/>
			</element>
			<!-- Net Dollar -->
			<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cf0" x="8" y="104" width="125" height="16" forecolor="#8C0A39" fontName="Khmer OS Siemreap" fontSize="8.5" bold="true" vTextAlign="Middle">
				<text><![CDATA[NET TOTAL ($):]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cf1" x="135" y="104" width="137" height="16" forecolor="#8C0A39" fontName="Khmer OS Siemreap" fontSize="8.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[($P{CurrencySymbol} != null ? $P{CurrencySymbol} + " " : "$ ") + ($P{TotalDollar} != null ? $P{TotalDollar} : "0.00")]]></expression>
			</element>
			<!-- Net Riel -->
			<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cf2" x="8" y="121" width="125" height="16" forecolor="#8C0A39" fontName="Khmer OS Siemreap" fontSize="8.5" bold="true" vTextAlign="Middle">
				<text><![CDATA[NET TOTAL (KHR):]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cf3" x="135" y="121" width="137" height="16" forecolor="#8C0A39" fontName="Khmer OS Siemreap" fontSize="8.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[($P{TotalRiel} != null ? $P{TotalRiel} : "0") + " KHR"]]></expression>
			</element>
		</element>

