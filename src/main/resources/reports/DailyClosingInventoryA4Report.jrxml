				<text><![CDATA[Cash Change:]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cee" x="92" y="94" width="89" height="14" forecolor="#0F172A" fontName="Khmer OS Siemreap" fontSize="7.0" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA["$" + ($P{CashChange} != null ? $P{CashChange} : "0.00")]]></expression>
			</element>
			<!-- Exchange Rate -->
			<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cef" x="6" y="108" width="85" height="14" forecolor="#475569" fontName="Khmer OS Siemreap" fontSize="7.0" vTextAlign="Middle">
				<text><![CDATA[Exchange Rate:]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cf0" x="92" y="108" width="89" height="14" forecolor="#0F172A" fontName="Khmer OS Siemreap" fontSize="7.0" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA["1$ = " + ($P{ExchangeRate} != null && !$P{ExchangeRate}.isBlank() ? $P{ExchangeRate} : "4,100")]]></expression>
			</element>
			<!-- Divider Line -->
			<element kind="line" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cf1" x="6" y="125" width="175" height="1">
				<pen lineWidth="0.5" lineColor="#CBD5E1"/>
