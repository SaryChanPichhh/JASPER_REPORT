				<text><![CDATA[NET TOTAL ($):]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cf3" x="92" y="130" width="89" height="16" forecolor="#8C0A39" fontName="Khmer OS Siemreap" fontSize="8.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[($P{CurrencySymbol} != null ? $P{CurrencySymbol} + " " : "$ ") + ($P{TotalDollar} != null ? $P{TotalDollar} : "0.00")]]></expression>
			</element>
			<!-- Net Riel -->
			<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cf4" x="6" y="148" width="85" height="16" forecolor="#8C0A39" fontName="Khmer OS Siemreap" fontSize="8.0" bold="true" vTextAlign="Middle">
				<text><![CDATA[NET TOTAL (KHR):]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cf5" x="92" y="148" width="89" height="16" forecolor="#8C0A39" fontName="Khmer OS Siemreap" fontSize="8.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[($P{TotalRiel} != null ? $P{TotalRiel} : "0") + " KHR"]]></expression>
			</element>
		</element>

