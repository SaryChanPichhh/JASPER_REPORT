					<text><![CDATA[FINANCIAL SUMMARY]]></text>
				</element>
			</element>
			<!-- Subtotal -->
			<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce3" x="6" y="24" width="85" height="14" forecolor="#475569" fontName="Khmer OS Siemreap" fontSize="7.0" vTextAlign="Middle">
				<text><![CDATA[Subtotal:]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce4" x="92" y="24" width="89" height="14" forecolor="#0F172A" fontName="Khmer OS Siemreap" fontSize="7.0" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[($P{CurrencySymbol} != null ? $P{CurrencySymbol} + " " : "$ ") + ($P{Subtotal} != null ? $P{Subtotal} : "0.00")]]></expression>
			</element>
			<!-- Discount -->
			<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce5" x="6" y="38" width="85" height="14" forecolor="#475569" fontName="Khmer OS Siemreap" fontSize="7.0" vTextAlign="Middle">
				<text><![CDATA[Discount:]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce6" x="92" y="38" width="89" height="14" forecolor="#DC2626" fontName="Khmer OS Siemreap" fontSize="7.0" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[($P{Discount} != null && !$P{Discount}.equals("0") && !$P{Discount}.equals("0.00") ? "-" + $P{Discount} : "0.00")]]></expression>
			</element>
			<!-- VAT -->
			<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce7" x="6" y="52" width="85" height="14" forecolor="#475569" fontName="Khmer OS Siemreap" fontSize="7.0" vTextAlign="Middle">
				<text><![CDATA[VAT:]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce8" x="92" y="52" width="89" height="14" forecolor="#0F172A" fontName="Khmer OS Siemreap" fontSize="7.0" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[$P{Vat} != null ? $P{Vat} : "0.00"]]></expression>
			</element>
			<!-- Expense USD -->
			<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce9" x="6" y="66" width="85" height="14" forecolor="#475569" fontName="Khmer OS Siemreap" fontSize="7.0" vTextAlign="Middle">
				<text><![CDATA[Expense ($):]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cea" x="92" y="66" width="89" height="14" forecolor="#0F172A" fontName="Khmer OS Siemreap" fontSize="7.0" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA["$" + ($P{Expense} != null ? $P{Expense} : "0.00")]]></expression>
			</element>
			<!-- Expense Riel -->
			<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ceb" x="6" y="80" width="85" height="14" forecolor="#475569" fontName="Khmer OS Siemreap" fontSize="7.0" vTextAlign="Middle">
				<text><![CDATA[Expense (KHR):]]></text>
			</element>
			<element kind="textField" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cec" x="92" y="80" width="89" height="14" forecolor="#0F172A" fontName="Khmer OS Siemreap" fontSize="7.0" hTextAlign="Right" vTextAlign="Middle">
				<expression><![CDATA[($P{ExpenseRiel} != null ? $P{ExpenseRiel} : "0") + " KHR"]]></expression>
