							<element kind="staticText" uuid="a1b2c3d4-0001-4444-8888-111122223342" x="0" y="0" width="97" height="16" fontName="Khmer OS Siemreap" fontSize="7.5" bold="true" hTextAlign="Left" vTextAlign="Middle">
								<text><![CDATA[ METHOD]]></text>
							</element>
						</columnHeader>
						<detailCell height="15" style="Table_TD">
							<element kind="textField" uuid="a1b2c3d4-0001-4444-8888-111122223343" x="0" y="0" width="97" height="15" fontName="Khmer OS Siemreap" fontSize="7.5" hTextAlign="Left" vTextAlign="Middle">
								<expression><![CDATA[" " + ($F{paymentType} != null ? $F{paymentType} : "")]]></expression>
							</element>
						</detailCell>
					</column>
					<!-- Total Received -->
					<column kind="single" uuid="a1b2c3d4-0001-4444-8888-111122223344" width="70">
						<property name="com.jaspersoft.studio.components.table.model.column.name" value="Column2"/>
						<columnHeader height="16" rowSpan="1" style="Table_CH">
							<element kind="staticText" uuid="a1b2c3d4-0001-4444-8888-111122223345" x="0" y="0" width="70" height="16" fontName="Khmer OS Siemreap" fontSize="7.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
								<text><![CDATA[AMOUNT ]]></text>
							</element>
						</columnHeader>
						<detailCell height="15" style="Table_TD">
							<element kind="textField" uuid="a1b2c3d4-0001-4444-8888-111122223346" x="0" y="0" width="70" height="15" fontName="Khmer OS Siemreap" fontSize="7.5" hTextAlign="Right" vTextAlign="Middle">
								<expression><![CDATA[($F{currencySymbol} != null ? $F{currencySymbol} + " " : "$ ") + ($F{totalReceived} != null ? $F{totalReceived} : "0.00")]]></expression>
							</element>
						</detailCell>
					</column>
				</component>
			</element>
		</element>

		<!-- Expense Breakdown Box (Middle: width 180) -->
		<element kind="frame" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cd4" x="182" y="34" width="180" height="195">
			<box>
				<pen lineWidth="0.5" lineColor="#CBD5E1"/>
			</box>
			<element kind="frame" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cd5" x="0" y="0" width="180" height="20" backcolor="#8C0A39" mode="Opaque">
				<element kind="staticText" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cd6" x="2" y="0" width="176" height="20" forecolor="#FFFFFF" fontName="Khmer OS Siemreap" fontSize="7.5" bold="true" hTextAlign="Center" vTextAlign="Middle">
					<text><![CDATA[EXPENSES]]></text>
				</element>
			</element>
			<!-- Expense Table Component -->
			<element kind="component" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5cd7" x="4" y="24" width="172" height="165">
				<property name="com.jaspersoft.studio.layout" value="com.jaspersoft.studio.editor.layout.VerticalRowLayout"/>
				<component kind="table">
					<datasetRun uuid="e3d2c1b0-9a8b-7c6d-5e4f-3a2b1c0d9e90" subDataset="ExpenseDataset">
						<dataSourceExpression><![CDATA[$P{ExpenseDataSource}]]></dataSourceExpression>
					</datasetRun>
					<!-- Expense Desc & By -->
					<column kind="single" uuid="a1b2c3d4-0001-4444-8888-111122223351" width="107">
						<property name="com.jaspersoft.studio.components.table.model.column.name" value="Column1"/>
						<columnHeader height="16" rowSpan="1" style="Table_CH">
							<element kind="staticText" uuid="a1b2c3d4-0001-4444-8888-111122223352" x="0" y="0" width="107" height="16" fontName="Khmer OS Siemreap" fontSize="7.5" bold="true" hTextAlign="Left" vTextAlign="Middle">
								<text><![CDATA[ DESC / BY]]></text>
							</element>
						</columnHeader>
						<detailCell height="15" style="Table_TD">
							<element kind="textField" uuid="a1b2c3d4-0001-4444-8888-111122223353" x="0" y="0" width="107" height="15" fontName="Khmer OS Siemreap" fontSize="7.5" hTextAlign="Left" vTextAlign="Middle">
								<expression><![CDATA[" " + ($F{expenseDesc} != null ? $F{expenseDesc} : "") + ($F{ExpenseBy} != null && !$F{ExpenseBy}.isBlank() ? " (" + $F{ExpenseBy} + ")" : "")]]></expression>
							</element>
						</detailCell>
					</column>
					<!-- Expense Amount -->
					<column kind="single" uuid="a1b2c3d4-0001-4444-8888-111122223354" width="65">
						<property name="com.jaspersoft.studio.components.table.model.column.name" value="Column2"/>
						<columnHeader height="16" rowSpan="1" style="Table_CH">
							<element kind="staticText" uuid="a1b2c3d4-0001-4444-8888-111122223355" x="0" y="0" width="65" height="16" fontName="Khmer OS Siemreap" fontSize="7.5" bold="true" hTextAlign="Right" vTextAlign="Middle">
								<text><![CDATA[AMOUNT ]]></text>
							</element>
						</columnHeader>
						<detailCell height="15" style="Table_TD">
							<element kind="textField" uuid="a1b2c3d4-0001-4444-8888-111122223356" x="0" y="0" width="65" height="15" fontName="Khmer OS Siemreap" fontSize="7.5" hTextAlign="Right" vTextAlign="Middle">
								<expression><![CDATA[($F{CurrencySymbol} != null ? $F{CurrencySymbol} + " " : "$ ") + ($F{ExpenseAmount} != null ? $F{ExpenseAmount} : "0.00")]]></expression>
							</element>
						</detailCell>
					</column>
				</component>
			</element>
