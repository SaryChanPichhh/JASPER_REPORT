		<!-- Financial Summary Box (Right: width 187) -->
		<element kind="frame" uuid="d1e2f3a4-b5c6-7a8b-9c0d-1e2f3a4b5ce0" x="368" y="34" width="187" height="195">
			<box>
				<pen lineWidth="0.5" lineColor="#CBD5E1"/>
